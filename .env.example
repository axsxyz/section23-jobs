# ── France Travail API ──────────────────────────────────────────────
# Register at https://francetravail.io/data/api to get credentials.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ── Adzuna API (optional) ─────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# ── RSS feeds (comma-separated URLs) ──────────────────────────────
# Leave empty to disable the RSS source. Example:
# RSS_FEED_URLS=https://jobs.example.com/feed.xml,https://another.example.org/rss
RSS_FEED_URLS=

# ── Filters ────────────────────────────────────────────────────────
TARGET_SECTORS=python,data,backend,developer
TARGET_LOCATION=Paris
TARGET_CONTRACT_TYPES=CDI,CDD
TARGET_SENIORITY=junior,mid

# ── LLM Scoring ───────────────────────────────────────────────────
OPENAI_API_KEY=
SCORING_MODEL=gpt-4o-mini
SCORING_THRESHOLD=7
TARGET_PROFILE=Backend Python developer, 3 years experience, interested in data engineering

# ── Notifications ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobbot:jobbot@postgres:5432/jobbot

# ── Web Application ───────────────────────────────────────────────
# Shared secret for webapp auth (required to enable the web UI).
WEBAPP_SECRET=change-me-to-a-strong-random-string

# ── Geocoding (Nominatim / OSM) ──────────────────────────────────
# Set a descriptive User-Agent with your own contact to enable background
# geocoding (Nominatim usage policy). Example:
# NOMINATIM_USER_AGENT=section23-jobs/0.1 you@example.com
NOMINATIM_USER_AGENT=
# Minutes between geocoding runs.
# GEOCODE_INTERVAL=10

# ── Scheduler intervals (minutes, optional) ───────────────────────
# FETCH_FRANCE_TRAVAIL_INTERVAL=120
# FETCH_RSS_INTERVAL=30
# FETCH_ADZUNA_INTERVAL=60
# SCORE_AND_NOTIFY_INTERVAL=5
